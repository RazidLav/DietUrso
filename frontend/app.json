{
  "expo": {
    "name": "UrsoFit",
    "slug": "dieturso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ursofit-icon.png",
    "scheme": "dieturso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.razidlav.dieturso"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ursofit-icon.png",
        "backgroundColor": "#B7FF2A"
      },
      "package": "com.razidlav.dieturso"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/ursofit-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ursofit-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#B7FF2A"
        }
      ],
      "expo-font",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
